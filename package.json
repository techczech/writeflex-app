{
  "name": "writeflex-app",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/build-vendored.mjs",
    "build:packages": "node scripts/build-vendored.mjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sharing-service/tsconfig.json",
    "test": "bun test",
    "build": "bun test tests/main/agent-parity.test.ts && bun run typecheck && bun run build:sharing-service && electron-vite build && bun scripts/stage-readflex-reader.ts",
    "build:sharing-service": "bun scripts/build-sharing-service.ts",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@bridle/contract": "file:./packages/bridle/contract",
    "@bridle/core": "file:./packages/bridle/core",
    "@bridle/electron": "file:./packages/bridle/electron",
    "@bridle/ledger": "file:./packages/bridle/ledger",
    "@app-patterns/outline": "file:./vendor/app-patterns/app-patterns-outline-0.3.0.tgz",
    "@bridle/react": "file:./packages/bridle/react",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@readflex/reader-embed": "file:./packages/readflex/reader-embed",
    "@readflex/sidecar": "file:./packages/readflex/sidecar",
    "@readflex/sqlite-driver": "file:./packages/readflex/sqlite-driver",
    "@readflex/zotero-bridge": "file:./packages/readflex/zotero-bridge",
    "@readflex/zotero-paths": "file:./packages/readflex/zotero-paths",
    "docx": "9.7.1",
    "dompurify": "^3.4.11",
    "lucide-react": "^1.21.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.0",
    "sharp": "0.35.3",
    "typebox": "1.1.38",
    "@bridle/cognition": "file:./packages/bridle/cognition",
    "@bridle/knowledge": "file:./packages/bridle/knowledge",
    "@bridle/lens": "file:./packages/bridle/lens",
    "@bridle/model-access": "file:./packages/bridle/model-access",
    "@bridle/packs": "file:./packages/bridle/packs",
    "@bridle/perception": "file:./packages/bridle/perception",
    "@bridle/secrets": "file:./packages/bridle/secrets"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "playwright": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "jszip": "3.10.1"
  },
  "license": "MIT",
  "author": "Dominik Lukeš",
  "repository": {
    "type": "git",
    "url": "https://github.com/techczech/writeflex-app.git"
  },
  "build": {
    "appId": "net.dominiklukes.writeflex",
    "productName": "WriteFlex",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/example-collection",
        "to": "example-collection"
      },
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "node_modules/.cache/writeflex/readflex-reader",
        "to": "readflex-reader"
      },
      {
        "from": "sharing-service-dist",
        "to": "sharing-service-dist"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "WriteFlex Link",
        "schemes": [
          "writeflex"
        ],
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      },
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "techczech",
      "repo": "writeflex-app",
      "releaseType": "draft"
    }
  }
}
