{
  "name": "writeflex-app",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "main": "./out/main/bootstrap.js",
  "scripts": {
    "postinstall": "node scripts/build-vendored.mjs",
    "build:packages": "node scripts/build-vendored.mjs",
    "dev": "electron-vite dev",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --noEmit -p sharing-service/tsconfig.json",
    "test": "bun test",
    "build": "bun test tests/main/agent-parity.test.ts && bun run typecheck && bun run build:sharing-service && bun run build:zotero-plugin && bun run build:agent-skill && electron-vite build && bun run build:backup-helper && bun scripts/stage-readflex-reader.ts",
    "build:sharing-service": "bun scripts/build-sharing-service.ts",
    "build:zotero-plugin": "bun scripts/build-zotero-plugin.ts",
    "build:agent-skill": "bun scripts/build-agent-skill.mjs",
    "build:backup-helper": "bun scripts/build-backup-helper.ts",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@bridle/contract": "file:./vendor/bridle/bridle-contract-0.3.1.tgz",
    "@bridle/core": "file:./vendor/bridle/bridle-core-0.17.0.tgz",
    "@bridle/electron": "file:./vendor/bridle/bridle-electron-0.2.5.tgz",
    "@bridle/ledger": "file:./vendor/bridle/bridle-ledger-0.1.2.tgz",
    "@app-patterns/outline": "file:./vendor/app-patterns/app-patterns-outline-0.3.0.tgz",
    "@bridle/react": "file:./vendor/bridle/bridle-react-0.2.7.tgz",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@readflex/reader-embed": "file:./packages/readflex/reader-embed",
    "@readflex/sidecar": "file:./packages/readflex/sidecar",
    "@readflex/sqlite-driver": "file:./packages/readflex/sqlite-driver",
    "@readflex/zotero-bridge": "file:./packages/readflex/zotero-bridge",
    "@readflex/zotero-paths": "file:./packages/readflex/zotero-paths",
    "docx": "9.7.1",
    "dompurify": "^3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "^1.21.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.0",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "typebox": "1.1.38",
    "@app-patterns/updates": "file:./vendor/app-patterns/app-patterns-updates-0.4.1.tgz",
    "@app-patterns/updates-react": "file:./vendor/app-patterns/app-patterns-updates-react-0.4.1.tgz"
  },
  "devDependencies": {
    "@app-patterns/vault-sync": "file:./vendor/app-patterns/app-patterns-vault-sync-0.5.1.tgz",
    "@playwright/test": "1.61.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "playwright": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "writeflex-build-typescript": "npm:typescript@6.0.3",
    "jszip": "3.10.1"
  },
  "license": "MIT",
  "author": "Dominik Lukeš",
  "repository": {
    "type": "git",
    "url": "https://github.com/techczech/writeflex-app.git"
  },
  "build": {
    "appId": "net.dominiklukes.writeflex",
    "productName": "WriteFlex",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/backup-helper/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/example-collection",
        "to": "example-collection"
      },
      {
        "from": "resources/sounds",
        "to": "sounds"
      },
      {
        "from": "node_modules/.cache/writeflex/readflex-reader",
        "to": "readflex-reader"
      },
      {
        "from": "sharing-service-dist",
        "to": "sharing-service-dist"
      },
      {
        "from": "zotero-plugin/dist",
        "to": "zotero-plugin"
      },
      {
        "from": "agent-skill-dist",
        "to": "agent-skill"
      },
      {
        "from": "out/backup-helper",
        "to": "vault-sync-helper",
        "filter": [
          "writeflex-backup-helper.js"
        ]
      },
      {
        "from": "vendor/bridle/LICENSE",
        "to": "third-party-notices/bridle/LICENSE"
      },
      {
        "from": "resources/whats-new",
        "to": "whats-new"
      },
      {
        "from": "vendor/app-patterns/LICENSE",
        "to": "third-party-notices/vault-sync/LICENSE"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "WriteFlex Link",
        "schemes": [
          "writeflex"
        ],
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      },
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "techczech",
      "repo": "writeflex-app",
      "releaseType": "draft"
    }
  },
  "overrides": {
    "@bridle/cognition": "file:./vendor/bridle/bridle-cognition-0.1.1.tgz",
    "@bridle/contract": "file:./vendor/bridle/bridle-contract-0.3.1.tgz",
    "@bridle/core": "file:./vendor/bridle/bridle-core-0.17.0.tgz",
    "@bridle/electron": "file:./vendor/bridle/bridle-electron-0.2.5.tgz",
    "@bridle/knowledge": "file:./vendor/bridle/bridle-knowledge-0.1.6.tgz",
    "@bridle/ledger": "file:./vendor/bridle/bridle-ledger-0.1.2.tgz",
    "@bridle/lens": "file:./vendor/bridle/bridle-lens-0.1.7.tgz",
    "@bridle/model-access": "file:./vendor/bridle/bridle-model-access-0.1.1.tgz",
    "@bridle/packs": "file:./vendor/bridle/bridle-packs-0.1.1.tgz",
    "@bridle/perception": "file:./vendor/bridle/bridle-perception-0.2.1.tgz",
    "@bridle/react": "file:./vendor/bridle/bridle-react-0.2.7.tgz",
    "@bridle/secrets": "file:./vendor/bridle/bridle-secrets-0.1.1.tgz",
    "sharp": "0.35.5",
    "undici": "8.12.2",
    "@bridle/readers": "file:./vendor/bridle/bridle-readers-0.1.1.tgz",
    "markdown-it": "14.3.3",
    "zod": "4.6.6",
    "dompurify": "3.4.17",
    "@app-patterns/updates": "file:./vendor/app-patterns/app-patterns-updates-0.4.1.tgz"
  }
}
