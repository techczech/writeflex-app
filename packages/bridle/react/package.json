{
  "name": "@bridle/react",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "bun build ./src/index.ts --outdir dist --target browser --format esm --packages external",
    "build:types": "node ../../../node_modules/writeflex-build-typescript/bin/tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "21.1.7",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "lucide-react": "1.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@bridle/core": "file:../core",
    "lucide-react": ">=0.468.0 <2",
    "react": ">=18"
  },
  "license": "MIT"
}
