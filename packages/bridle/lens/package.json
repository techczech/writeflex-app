{
  "name": "@bridle/lens",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "bridle-lens": "./dist/cli.js",
    "bridle-lens-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build:js": "bun build ./src/index.ts ./src/cli.ts ./src/mcp.ts --outdir dist --target node --format esm --packages external",
    "build:types": "node ../../../node_modules/writeflex-build-typescript/bin/tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@bridle/core": "file:../core"
  },
  "license": "MIT"
}
