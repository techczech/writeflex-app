{
  "name": "@bridle/perception",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@bridle/contract": "file:../contract",
    "@bridle/model-access": "file:../model-access"
  },
  "license": "MIT"
}
