{
  "name": "@bridle/electron",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js",
      "default": "./dist/preload.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "default": "./dist/transport.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:js": "bun build ./src/index.ts ./src/main.ts ./src/preload.ts ./src/renderer.ts ./src/transport.ts --outdir dist --target node --format esm --packages external",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "21.1.7",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@bridle/core": "file:../core",
    "@bridle/react": "file:../react",
    "electron": ">=30 <43",
    "react": ">=18"
  },
  "license": "MIT"
}
