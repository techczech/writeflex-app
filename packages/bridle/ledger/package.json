{
  "name": "@bridle/ledger",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external",
    "build:types": "tsc -p tsconfig.build.json && bun run scripts/fix-dts-extensions.ts",
    "build": "bun run build:js && bun run build:types"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
