{
  "name": "@bridle/outline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:js": "bun build ./src/index.ts --outdir dist --target browser --format esm --packages external",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
